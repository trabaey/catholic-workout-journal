# NOTE: this is deliberately NOT a copy of .dockerignore. That file narrows what
# gets baked into the image, so it excludes *.md, testing/, scripts/ and unused/
# — all of which are source and belong in version control. The two files overlap
# only on secrets, data and build artefacts.

# ── Secrets ──────────────────────────────────────────────────────────────────
# GARMIN_EMAIL / GARMIN_PASSWORD live here. data/garmin.env is canonical on the
# Pi (see CLAUDE.md); OMV also renames a project-root .env to
# workout-tracker.env on rebuild, so both spellings are covered.
.env
*.env
!.env.example

# ── User data ────────────────────────────────────────────────────────────────
# The whole bind-mounted volume: the live workout.db (+ its -wal/-shm), every
# workout.db.bak-*, the workout_full_backup_*.db snapshots, garmin.env, and the
# cached .garminconnect/ OAuth tokens. db.js mkdir -p's this on boot, so an
# empty checkout is fine.
data/

# ── Licensed data ─────────────────────────────────────────────────────────────
# The RepDB exercise library may not be redistributed as a dataset, so it is
# never committed: each install downloads it into data/repdb/ from Settings.
# public/repdb/ is where it used to be vendored, and still sits on old checkouts.
public/repdb/

# ── OMV-generated (auto-generated banner; regenerated by the GUI) ────────────
compose.yml
compose.override.yml
workout-tracker.yml

# ── Dependencies & build artefacts ───────────────────────────────────────────
node_modules/
npm-debug.log*
__pycache__/
*.pyc

# ── Test output ──────────────────────────────────────────────────────────────
# Screenshots accumulate a set per run label, and browser-test pulls ~9MB of
# playwright into its own node_modules (already covered above).
testing/browser-test/shots/

# ── Editor / tooling local state ─────────────────────────────────────────────
# settings.local.json is per-machine; a shared .claude/settings.json, if one is
# ever added, stays tracked.
.claude/settings.local.json
.claude/scheduled_tasks.lock
.DS_Store
