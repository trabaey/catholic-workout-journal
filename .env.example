# Garmin sync credentials for the FIRST user, consumed by garmin_sync.py's
# load_credentials(). You normally don't need this file at all: enter them in
# Settings -> Account & data -> Garmin instead, which stores them per user
# under data/. It is only a fallback for running garmin_sync.py by hand.
#
# garmin_sync.py checks data/garmin.env first, then .env / workout-tracker.env.
# Prefer data/garmin.env: data/ is the bind mount, so it survives rebuilds.

GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=

# How many recent activities to pull per run.
GARMIN_LIMIT=20

# Where garmin_sync.py POSTs what it finds. Inside the container this is the
# app's own port; from another host, point it at the Pi.
WORKOUT_API=http://localhost:3000
